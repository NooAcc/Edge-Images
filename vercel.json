{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/image/:source*",
      "destination": "/api/image?source=:source*"
    }
  ],
  "functions": {
    "api/image.js": {
      "maxDuration": 40
    }
  }
}
